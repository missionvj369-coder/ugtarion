# Cloudflare Pages compatible redirects
# Cloudflare Pages handles SPA fallback natively - no catch-all needed
# (catch-all /* /index.html 200 causes infinite loops on Cloudflare)

# Auth routes - specific paths first
/auth/callback               /index.html   200
/verify/*                    /index.html   200

# Password reset routes - preserve query params for token
/password-reset/confirm      /index.html   200
/password-reset              /index.html   200
/password-reset/*            /index.html   200