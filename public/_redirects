# Netlify SPA Redirects for Universal Guard Trust
# This file handles client-side routing for the React app

# SPA fallback - all routes except API and static files go to index.html
/*    /index.html   200

# Password reset routes
/password-reset    /index.html   200
/password-reset/*  /index.html   200

# Auth routes
/auth/callback     /index.html   200
/verify/*          /index.html   200

# API proxy (if needed)
/api/*             https://api.ugtglobal.space/:splat  200